# Copy to .env and generate AUTH__SECRET with: docker run --rm python:3.14-slim python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH__SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
AUTH__ISSUER=auth-template
AUTH__AUDIENCE=auth-template-api
AUTH__ACCESS_TTL_SECONDS=900
AUTH__SESSION_TTL_SECONDS=2592000
AUTH__TRANSPORT=bearer
AUTH__COOKIE_SECURE=true
AUTH__ALLOWED_ORIGINS=[]
AUTH__REQUESTS_PER_MINUTE=20
DATABASE__DSN=postgresql+psycopg://auth:auth-local-only@postgres:5432/auth
DATABASE__POOL_SIZE=5
HTTP__HOST=127.0.0.1
HTTP__PORT=8000
HTTP__CONCURRENCY=100
FRONTEND_PORT=3000
MAIL__HOST=mailpit
MAIL__PORT=1025
MAIL__SENDER=no-reply@auth.local
MAIL__SECURITY=plain
MAIL__USERNAME=
MAIL__PASSWORD=
MAIL__TIMEOUT_SECONDS=5
MAILPIT_PORT=8025
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth-local-only
POSTGRES_DB=auth
POSTGRES_PORT=5432
